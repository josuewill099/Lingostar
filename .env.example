# Copy to .env for local dev, and set the same keys as Cloudflare Pages
# environment variables (Settings > Environment variables) for production.

# --- Giscus comments (https://giscus.app) ---
PUBLIC_GISCUS_REPO=your-org/your-repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# --- Contact form function (functions/api/contact.ts) ---
# These two are read server-side by the Pages Function, not exposed to the
# browser — do NOT prefix them with PUBLIC_.
RESEND_API_KEY=
CONTACT_TO=you@yourdomain.com
