# Copy to .env for local dev, and set the same keys as Cloudflare Workers
# environment variables (Settings > Variables and Secrets) for production.

# --- Giscus comments (https://giscus.app) ---
PUBLIC_GISCUS_REPO=your-org/your-repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# --- Contact form (src/worker.ts) ---
# These two are read server-side by the Worker, not exposed to the
# browser — do NOT prefix them with PUBLIC_.
RESEND_API_KEY=
CONTACT_TO=you@yourdomain.com
