---
import SpanishNav from '../../../components/SpanishNav.astro';
import SpanishFooter from '../../../components/SpanishFooter.astro';

export const prerender = true;

const collectionLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "Apprendre l'espagnol",
  url: 'https://lingostar.ai/fr/espagnol/',
  inLanguage: 'fr',
  description: "Ressources gratuites de Lingostar pour apprendre l'espagnol : tableaux de conjugaison et pratique de conversation avec l'IA.",
});
const crumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://lingostar.ai/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Espagnol', item: 'https://lingostar.ai/fr/espagnol/' },
  ],
});
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9154720924448333"
   crossorigin="anonymous"></script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-M8YB8MCJV0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-M8YB8MCJV0');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Apprendre l'espagnol | Lingostar</title>
  <meta name="description" content="Ressources gratuites de Lingostar pour apprendre l'espagnol : tableaux de conjugaison et pratique de conversation avec l'IA." />
  <link rel="canonical" href="https://lingostar.ai/fr/espagnol/" />
  <link rel="alternate" hreflang="fr" href="https://lingostar.ai/fr/espagnol/" />
  <link rel="alternate" hreflang="en" href="https://lingostar.ai/spanish/" />
  <link rel="alternate" hreflang="pt-BR" href="https://lingostar.ai/pt/espanhol/" />
  <link rel="alternate" hreflang="x-default" href="https://lingostar.ai/spanish/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Public+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={collectionLd} />
  <script type="application/ld+json" set:html={crumbLd} />
  <style>
    :root{--ink:#1f1a16;--paper:#faf6ef;--card:#fffdf8;--red:#b3372c;--amber:#d99a2b;--line:#e7ddcc;--soft:#6f6558}
    *{box-sizing:border-box;margin:0}
    body{font-family:'Public Sans',sans-serif;background:var(--paper);color:var(--ink);line-height:1.6}
    .wrap{max-width:1040px;margin:0 auto;padding:0 22px}
    header.hero{padding:40px 0 34px;border-bottom:3px solid var(--ink)}
    h1{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(2.6rem,7vw,4.2rem);line-height:1.02}
    .sub{font-size:1.15rem;color:var(--soft);margin-top:10px}
    .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin:34px 0 60px}
    .card{background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:22px 24px}
    .card h2{font-family:'Fraunces',serif;font-size:1.3rem;margin-bottom:8px}
    .card p{color:var(--soft);font-size:.92rem;margin-bottom:14px}
    .card a{color:var(--red);font-weight:700;text-decoration:none}
  </style>
</head>
<body>
<div class="wrap">
  <SpanishNav lang="fr" />
  <header class="hero">
    <h1>Apprendre l'espagnol</h1>
    <p class="sub">Des ressources gratuites pour progresser en espagnol, complétées par la pratique de conversation IA de Lingostar.</p>
  </header>
  <div class="cards">
    <div class="card">
      <h2>Conjugaison des verbes</h2>
      <p>Tableaux de conjugaison complets pour les verbes espagnols les plus courants — tous les temps et modes, formes irrégulières signalées.</p>
      <a href="/fr/espagnol/conjugaison/">Voir les verbes →</a>
    </div>
    <div class="card">
      <h2>Pratiquez avec un tuteur IA</h2>
      <p>Parlez naturellement avec le partenaire de conversation IA de Lingostar et recevez un retour instantané sur la grammaire et la prononciation.</p>
      <a href="https://lingostar.ai/practice">Commencer à pratiquer →</a>
    </div>
  </div>
  <SpanishFooter lang="fr" />
</div>
</body>
</html>
