---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pagesFr', 'terms-of-service');
const { Content } = await entry.render();
const translations = {
  en: 'https://lingostar.ai/terms-of-service/',
  fr: 'https://lingostar.ai/fr/terms-of-service/',
  'pt-BR': 'https://lingostar.ai/pt/terms-of-service/',
};
---
<BaseLayout title={`${entry.data.title} | Lingostar`} lang="fr" noindex translations={translations}>
  <article>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
