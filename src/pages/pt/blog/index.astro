---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogPt', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Lingostar Blog',
  url: 'https://lingostar.ai/pt/blog/',
  inLanguage: 'pt-BR',
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `https://lingostar.ai/pt/blog/${post.slug}/`,
    datePublished: post.data.pubDate.toISOString(),
  })),
});

function excerpt(body: string, length = 140) {
  const plain = body
    .replace(/^#+\s+.*/gm, '')
    .replace(/[*_`>]/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length <= length ? plain : plain.slice(0, length).replace(/\s+\S*$/, '') + '…';
}

function readingTime(body: string) {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

const translations = {
  en: 'https://lingostar.ai/blog/',
  fr: 'https://lingostar.ai/fr/blog/',
  'pt-BR': 'https://lingostar.ai/pt/blog/',
};
---
<BaseLayout title="Blog | Lingostar" lang="pt" structuredData={blogLd} translations={translations} wide>
  <div class="blog-hero">
    <h1>Blog</h1>
    <p class="blog-hero-sub">Guias práticos sobre aprendizado de idiomas, ferramentas de IA e o que realmente funciona.</p>
  </div>
  {posts.length > 0 ? (
    <div class="post-grid">
      {posts.map((post) => (
        <a class="post-card" href={`/pt/blog/${post.slug}/`}>
          <h2>{post.data.title}</h2>
          <p class="post-card-excerpt">{post.data.description || excerpt(post.body)}</p>
          <div class="post-card-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body)} min de leitura</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="contact-intro">Os artigos em português estão a caminho. Enquanto isso, confira nosso <a href="/blog/">blog em inglês</a>.</p>
  )}
</BaseLayout>
