---
import BaseLayout from '../../layouts/BaseLayout.astro';

const contactLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: 'https://lingostar.ai/pt/contact/',
  inLanguage: 'pt-BR',
  mainEntity: {
    '@type': 'Organization',
    name: 'Lingostar',
    url: 'https://lingostar.ai',
    email: 'hello@lingostar.ai',
  },
});
const translations = {
  en: 'https://lingostar.ai/contact/',
  fr: 'https://lingostar.ai/fr/contact/',
  'pt-BR': 'https://lingostar.ai/pt/contact/',
};
---
<BaseLayout title="Contato | Lingostar" lang="pt" structuredData={contactLd} translations={translations}>
  <h1>Contato</h1>
  <p class="contact-intro">Envie-nos uma mensagem e responderemos o mais rápido possível, ou escreva diretamente para
    <a href="mailto:hello@lingostar.ai">hello@lingostar.ai</a>.</p>

  <form class="contact-form" method="POST" action="/api/contact" id="contact-form">
    <div class="field">
      <label for="contact-name">Nome</label>
      <input type="text" id="contact-name" name="name" placeholder="Seu nome" required />
    </div>
    <div class="field">
      <label for="contact-email">E-mail</label>
      <input type="email" id="contact-email" name="email" placeholder="voce@exemplo.com" required />
    </div>
    <div class="field">
      <label for="contact-message">Mensagem</label>
      <textarea id="contact-message" name="message" rows="6" placeholder="Como podemos ajudar?" required></textarea>
    </div>
    <button type="submit">Enviar mensagem</button>
    <p id="contact-status" role="status"></p>
  </form>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('contact-status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Enviando…';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });
        if (!response.ok) throw new Error('Request failed');
        status.textContent = 'Obrigado — sua mensagem foi enviada.';
        form.reset();
      } catch {
        status.textContent = 'Algo deu errado. Tente novamente mais tarde.';
      }
    });
  </script>
</BaseLayout>
