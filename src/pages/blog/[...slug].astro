---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const frPosts = await getCollection('blogFr', ({ data }) => !data.draft);
  const ptPosts = await getCollection('blogPt', ({ data }) => !data.draft);
  const frSlugs = new Set(frPosts.map((p) => p.slug));
  const ptSlugs = new Set(ptPosts.map((p) => p.slug));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, hasFrenchVersion: frSlugs.has(post.slug), hasPortugueseVersion: ptSlugs.has(post.slug) },
  }));
}

const { post, hasFrenchVersion, hasPortugueseVersion } = Astro.props;
const { Content } = await post.render();

const words = post.body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const blogPostingLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  ...(post.data.author ? { author: { '@type': 'Person', name: post.data.author } } : {}),
  ...(post.data.image ? { image: new URL(post.data.image, Astro.site).href } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Lingostar',
    logo: { '@type': 'ImageObject', url: 'https://lingostar.ai/logo.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
});
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lingostar.ai/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://lingostar.ai/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title },
  ],
});

// Only advertise an hreflang alternate for a language when a translation of
// this exact post actually exists -- a self-referencing-only pair isn't useful.
const altTranslations: Record<string, string> = {};
if (hasFrenchVersion) altTranslations.fr = `https://lingostar.ai/fr/blog/${post.slug}/`;
if (hasPortugueseVersion) altTranslations['pt-BR'] = `https://lingostar.ai/pt/blog/${post.slug}/`;
const translations = Object.keys(altTranslations).length > 0
  ? { en: canonicalUrl, ...altTranslations }
  : undefined;
---
<BaseLayout title={`${post.data.title} | Lingostar`} description={post.data.description} structuredData={[blogPostingLd, breadcrumbLd]} translations={translations}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      {post.data.author && (
        <span class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21a8 8 0 0 0-16 0" /><circle cx="12" cy="7" r="4" /></svg>
          By {post.data.author}
        </span>
      )}
      <span class="meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      </span>
      <span class="meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
        {readingMinutes} min read
      </span>
      {post.data.updatedDate && (
        <span class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
          Updated: <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
        </span>
      )}
    </div>
    <Content />
  </article>
  <hr />
  <Comments />
</BaseLayout>
