---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  structuredData?: string;
  wide?: boolean;
  lang?: string;
  // Same object passed by every language version of a page, e.g.
  // { en: 'https://lingostar.ai/contact/', fr: 'https://lingostar.ai/fr/contact/' }.
  // Renders reciprocal hreflang tags (including a self-reference) plus
  // x-default pointing at the English version.
  translations?: Record<string, string>;
}

const { title, description = 'Lingostar', noindex = false, structuredData, wide = false, lang = 'en', translations } = Astro.props;

// Site-wide Organization block, present on every BaseLayout page. Pages
// pass their own additional JSON-LD (BlogPosting, ContactPage, etc.) via
// the structuredData prop.
const organizationLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Lingostar',
  url: 'https://lingostar.ai',
  logo: 'https://lingostar.ai/logo.png',
});

// `lang` stays a short internal key ('en'/'fr'/'pt', matching Header/Footer's
// lookup tables) everywhere except the actual <html lang> attribute, which
// needs full BCP-47 for correctness.
const HTML_LANG: Record<string, string> = { pt: 'pt-BR' };
const htmlLang = HTML_LANG[lang] || lang;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9154720924448333"
     crossorigin="anonymous"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M8YB8MCJV0"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-M8YB8MCJV0');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {!noindex && <script type="application/ld+json" set:html={organizationLd} />}
    {!noindex && structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {translations && Object.entries(translations).map(([hreflang, href]) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {translations?.en && <link rel="alternate" hreflang="x-default" href={translations.en} />}
  </head>
  <body style={wide ? '--content-width: 64rem;' : undefined}>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
